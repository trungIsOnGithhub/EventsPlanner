    function addOptions() {
        const pollOptionsContainerElement = $("#option-container");
        let beforeAddOptionCount = pollOptionsContainerElement.children().length;
    
        const timeOption = $(`<div class="card m-3" id="timeslot${beforeAddOptionCount}">
                <div class="card-header text-center">
                    Timeslot ${beforeAddOptionCount}
                </div>
                <ul class="list-group list-group-flush">
                    <li class="list-group-item">
                        <input type="date" class="block" name="date${beforeAddOptionCount}">
                    </li>
                    <li class="list-group-item">
                        <span class="d-inline-flex">
                            <select class="form-control mt-1 flex-shrink-1"
                                name="starttime${beforeAddOptionCount}"
                                oninput="changeEndTimeOptionsByStartTime(${beforeAddOptionCount})"
                            >
                            </select>
                            <span class="pt-1 px-1">to</span>
                            <select class="form-control mt-1 flex-shrink-1"
                                name="endtime${beforeAddOptionCount}"
                                oninput="changeStartTimeOptionsByEndTime(${beforeAddOptionCount})"
                            >
                            </select>
                        </span>
                    </li>
                </ul>
                <a class="btn btn-danger" onclick="deletePollOption(${beforeAddOptionCount})"><i class="fa fa-times" aria-hidden="true"></i> Delete</a>
            </div>`);

        pollOptionsContainerElement.append(timeOption) 

        fillTimeOptions(`[name="starttime${beforeAddOptionCount}"]`, 0.0, 24.0, 0.5);
        fillTimeOptions(`[name="endtime${beforeAddOptionCount}"]`, 0.0, 24.0, 0.5);
    }
    function reorderPollOptions() {
        $("#option-container > .date-option").sort(function(a, b) {
            const dateA = a.childNodes[0].valueAsDate;
            const dateB = b.childNodes[0].valueAsDate;

            return dateA - dateB;
        }).appendTo($("#option-container"));
    }
    function deletePollOption(elementNumberToDelete) {
        const elementToDelete = document.getElementById(`timeslot${elementNumberToDelete}`);
        if (elementToDelete) {
            document.getElementById("option-container").removeChild(elementToDelete);
            console.log('==============', elementToDelete);
        }
    }
    function fillTimeOptions(selectElementIdToFill ,startTimeFloat, endTimeFloat, offset) {
        const timeSelectElement = document.querySelector(selectElementIdToFill);

        console.log('=================');
        if (startTimeFloat >= 0.0 && endTimeFloat <= 25.0 && endTimeFloat >= startTimeFloat) {
            while (startTimeFloat <= endTimeFloat) {
                let integralPart = Math.trunc(startTimeFloat);
                let decimalPart = startTimeFloat - integralPart;

                let strDateValue = '' + integralPart;

                if (decimalPart === 0.5) {
                    strDateValue += ':30';
                }
                else if (decimalPart === 0.25) {
                    strDateValue += ':15'
                }
                else if (decimalPart === 0.0) {
                    strDateValue += ':00'
                } 

                let timeOption = document.createElement('option');
                timeOption.innerText = strDateValue;
                timeOption.setAttribute('value', startTimeFloat);
                timeSelectElement.append(timeOption);

                startTimeFloat += offset;
            }
        }
    }
    function changeStartTimeOptionsByEndTime(elementNumberToDelete) {
        // console.log('||||||||||||||||1111111111111')
        if (elementNumberToDelete >= 0) {
            // const pollOptionsContainerElement = document.querySelector("option-container");
            // pollOptionsContainerElement.removeChild(pollOptionsContainerElement.children[elementNumberToDelete-1]);
            let tempStartTimeValue = parseFloat(
                document.querySelector(`[name="starttime${elementNumberToDelete}"]`)?.value || -1.0);
            let targetEndTimeValue = parseFloat(
                document.querySelector(`[name="endtime${elementNumberToDelete}"]`).value);
            // alert(targetEndTimeValue+'[[[[[[[[[[[[[]]]]]]]]]]]]]')

            $(`[name="starttime${elementNumberToDelete}"]`).empty();
            fillTimeOptions(`[name="starttime${elementNumberToDelete}"]`, 0.0, targetEndTimeValue, 0.5);

            if (tempStartTimeValue <= targetEndTimeValue && tempStartTimeValue >= 0.0) {// valid end time
                document.querySelector(`[name="starttime${elementNumberToDelete}"]`).value = tempStartTimeValue;
            }
        }
    }
    function changeEndTimeOptionsByStartTime(elementNumberToDelete) {
        // console.log('||||||||||||||||2222222222222')
        if (elementNumberToDelete >= 0) {
            // const endTimeContainerElement = document.querySelector(`[name="endtime${elementNumberToDelete}"]`);
            // pollOptionsContainerElement.removeChild(pollOptionsContainerElement.children[elementNumberToDelete-1]);
            let tempEndTimeValue = parseFloat(
                document.querySelector(`[name="endtime${elementNumberToDelete}"]`)?.value || -1.0);
            let targetStartTimeValue = parseFloat(
                document.querySelector(`[name="starttime${elementNumberToDelete}"]`).value);
            // alert(targetStartTimeValue+'??????????????????????')

            $(`[name="endtime${elementNumberToDelete}"]`).empty();
            fillTimeOptions(`[name="endtime${elementNumberToDelete}"]`, targetStartTimeValue, 24.0, 0.5);

            if (tempEndTimeValue >= targetStartTimeValue && tempEndTimeValue <= 24.0) {// valid end time
                document.querySelector(`[name="endtime${elementNumberToDelete}"]`).value = tempEndTimeValue;
            }
        }
    }
    console.log('-----')
</script>